{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mekhanes-contact",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "routes": [
    { "pattern": "mekhanes.3lraven.net/api/contact*", "zone_name": "3lraven.net" }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://mekhanes.3lraven.net",
    "MAIL_FROM": "contact@mekhanes.3lraven.net",
    "MAIL_TO": "work.liruk@gmail.com"
  },
  "send_email": [
    { "name": "EMAIL", "destination_address": "work.liruk@gmail.com" }
  ],
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
